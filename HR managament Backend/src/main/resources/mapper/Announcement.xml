        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.Mapper.AnnouncementMapper">

        <insert id="insertAnnouncement">
            insert into announcements(title,content,created_at) values (#{title},#{content},NOW())
        </insert>

</mapper>
