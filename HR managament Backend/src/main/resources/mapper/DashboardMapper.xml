<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.Mapper.DashboardMapper">

    <select id="getTotalEmployee" resultType="int">
        SELECT COUNT(*) FROM employee
    </select>

    <select id="getTotalActivePerson" resultType="int">
        SELECT COUNT(*) FROM employee WHERE status = 'ACTIVE'
    </select>

    <select id="getTotalInActivePerson" resultType="int">
        SELECT COUNT(*) FROM employee WHERE status = 'INACTIVE'
    </select>

    <select id="getTotalDepartment" resultType="int">
        SELECT COUNT(*) FROM department
    </select>

    <select id="getTotalPosition" resultType="int">
        SELECT COUNT(*) FROM E_position
    </select>

    <select id="getChartData" resultType="com.example.demo.Model.ChartDTO">
        SELECT
            d.name AS name,
            COUNT(e.id) AS value
        FROM employee e
        JOIN department d ON e.department_id = d.id
        GROUP BY d.name
    </select>

    <select id="getAnnouncementLists" resultType="com.example.demo.Model.AnnoucementList">
       select title,content,created_at as createdTime from announcements;
    </select>

</mapper>
